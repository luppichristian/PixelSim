id(pixelsim)
name("PixelSim")
ver(0.1.0)

targets(
  header_lib(
    id(stb_truetype)
    output(stb_truetype)
    repo(
      link("https://github.com/nothings/stb.git")
      commit("2c980bb59875b0d32144a71867fbdebb2f77cd20")
    )
    units(stb_truetype.h)
    include_dirs(.)
  )

  consoleless(
    id(pixelsim_app)
    output(PixelSim)
    lang(c)
    stdver(c11)
    warning_level(medium)
    units(
      src/main.c
      src/sim_brush.c
      src/sim_clock.c
      src/sim_palette.c
      src/sim_viewport.c
    )
    include_dirs(src)
    dependencies(stb_truetype)
    link_libs(d3d11 dxgi dxguid d3dcompiler user32 gdi32)
  )
)
